{
  "name": "reliefrelay",
  "version": "0.1.0",
  "private": true,
  "description": "ReliefRelay - flood-relief coordination with a conversational voice assistant",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:reset:hard": "tsx scripts/reset.ts --hard",
    "test": "vitest run",
    "test:watch": "vitest",
    "chain:node": "hardhat node",
    "chain:compile": "hardhat compile",
    "chain:test": "hardhat test",
    "chain:deploy": "hardhat run chain/deploy.cjs --network localhost",
    "verify": "npm run typecheck && npm run test && npm run chain:test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "ethers": "6.17.0",
    "leaflet": "1.9.4",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.1",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.18.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "hardhat": "2.29.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
