# ─────────────────────────────────────────────────────────────────────────────
# ReliefRelay environment configuration
#
# Everything below is OPTIONAL. With an empty .env the app still runs with:
#   - full text-based request submission, coordination, allocation and delivery
#   - the deterministic on-device extractor (labelled "rule-based" in the UI)
#   - a clearly-labelled SIMULATED environmental advisory feed
#   - a clearly-labelled pre-recorded voice demonstration (no service is called)
# Each key you fill in flips exactly one capability from fallback to live, and
# the UI reports which provider actually answered. Copy to `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database ----------------------------------------------------------------
# SQLite file. Relative paths resolve from the repository root.
RELIEFRELAY_DB_PATH=./data/reliefrelay.db

# --- Speech to text ----------------------------------------------------------
# STT_PROVIDER: openai | deepgram | none   (default: none)
STT_PROVIDER=none
# For STT_PROVIDER=openai (Whisper transcription endpoint).
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_BASE_URL=https://api.openai.com/v1
# For STT_PROVIDER=deepgram.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2

# --- Text to speech ----------------------------------------------------------
# TTS_PROVIDER: openai | none   (default: none -> browser speech synthesis if
# the browser supports it, otherwise text only)
TTS_PROVIDER=none
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Conversational extraction ----------------------------------------------
# EXTRACTION_PROVIDER: anthropic | rules   (default: rules)
EXTRACTION_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Environmental / flood advisory feed ------------------------------------
# ENV_FEED_PROVIDER: geojson | scenario   (default: scenario)
# `geojson` fetches a GeoJSON FeatureCollection of advisories from
# ENV_FEED_URL. See docs/ARCHITECTURE.md for the expected properties.
ENV_FEED_PROVIDER=scenario
ENV_FEED_URL=
ENV_FEED_SOURCE_NAME=
ENV_FEED_ATTRIBUTION_URL=

# --- Local EVM chain (supply attestations) ----------------------------------
# Leave CHAIN_ENABLED=false to run with attestations queued as "pending".
CHAIN_ENABLED=false
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_CONTRACT_ADDRESS=
# Hardhat account #0 private key (well-known local development key, no value).
CHAIN_ATTESTER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Emergency escalation ----------------------------------------------------
# Shown verbatim when someone reports immediate danger. Configure for your
# region before any real use. The app never claims responders were notified.
EMERGENCY_NUMBER=112
EMERGENCY_LABEL=Riverbend District emergency services (fictional demonstration)

# --- Privacy -----------------------------------------------------------------
# Keep server-side audio after transcription? Default false = delete at once.
RETAIN_SERVER_AUDIO=false

# --- Session cookies ---------------------------------------------------------
# Any long random string. A development default is used if unset.
SESSION_SECRET=
